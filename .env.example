# Personal Access Token (classic) с правом read:packages —
# нужен на docker build, чтобы восстановить пакеты AlfaHackaton.* из GitHub Packages
# AuthGateway читает токен из отдельного .github-token (BuildKit secret, chmod 600).
GITHUB_TOKEN=
GITHUB_USERNAME=
# Root host URL of ContextService for CompanyService evidence validation.
CONTEXT_SERVICE_BASE_URL=

# Должны совпадать с настройками сервиса, который выпускает JWT
JWT_SECRET=dev-secret-0123456789abcdef-change-me
JWT_ISSUER=AlfaHackathon
JWT_AUDIENCE=AlfaHackathon

# Downstream-сервисы гейтвея
SERVICES_ADDRESS=http://user-service:8080
AUTH_SERVICE_ADDRESS=http://auth-service:8080
AGENT_SERVICE_ADDRESS=http://agent-service:3000

# Postgres: у КАЖДОГО сервиса своя база (изоляция данных) — см. postgres-init/init-databases.sh
# POSTGRES_DB — база по умолчанию контейнер postgres (healthcheck), сервисам она не принадлежит
POSTGRES_DB=postgres
USER_SERVICE_DB=user-service
COMPANY_SERVICE_DB=company-service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Общий секрет для внутренних вызовов между сервисами (user-service <-> auth-service)
# Задайте своё значение — дефолт сознательно не зашит
INTERNAL_SECRET=

# Включён ли свагер в сервисах (true/false)
SWAGGER_ENABLED=true

# Парсер новостей: интервал опроса TASS воркером (сек)
TASS_POLL_INTERVAL_SECONDS=30

# graph-service: предзагрузка при старте (первый старт 3-5 мин, кэш в volume)
GRAPH_PRELOAD_METRICS=true
GRAPH_PRELOAD_COMMUNITIES=true
GRAPH_PRELOAD_EMBEDDINGS=true

# AgentService: separate database; use a URL-safe password.
AGENT_POSTGRES_PASSWORD=
# Model configuration: copy ../AgentService/.env.example to ../AgentService/.env
# and set LLM_BASE_URL, LLM_API_KEY, LLM_MODEL there.
